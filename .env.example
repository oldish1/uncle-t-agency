# ══════════════════════════════════════════════════════════════
# aios-template, API keys
# ══════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in keys as you add capabilities.
# NEVER commit .env. The .gitignore already protects it.
#
# You don't need any of these to finish the install. /install walks
# you through each one at the moment it matters, with a live test.
#
# ══════════════════════════════════════════════════════════════


# ─── WORKSPACE ────────────────────────────────────────────────
# Your timezone, for anything calendar- or schedule-shaped.
# Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=UTC

# Your email. Used only for polite access to open APIs (faster, fewer limits).
CONTACT_EMAIL=


# ─── RESEARCH STACK ───────────────────────────────────────────
# Supadata, YouTube transcripts, TikTok, social video, YouTube search.
# Needed for deep research to reach video platforms.
# Get yours: https://supadata.ai/dashboard → API Keys
SUPADATA_API_KEY=

# Firecrawl, high-quality web scraping. Worth the money vs the basic
# built-in tools: handles JavaScript-heavy sites, bot-protected pages,
# and PDFs, and pulls much cleaner content.
# Get yours: https://firecrawl.dev → Dashboard → API Keys
FIRECRAWL_API_KEY=

# xAI Grok, X/Twitter search (what's being said, by whom, right now).
# Get yours: https://console.x.ai → API Keys
XAI_API_KEY=

# X API Bearer Token, optional add-on for engagement numbers on posts.
# Get yours: https://developer.x.com → Projects & Apps → Keys and Tokens
X_BEARER_TOKEN=

# Apify, scraping for the places other tools can't reach
# (Instagram, TikTok, LinkedIn, marketplaces). Set up on demand:
# ask Claude when you need to scrape something.
# Get yours: https://console.apify.com → Settings → Integrations
APIFY_API_TOKEN=


# ─── GOOGLE SERVICES (Gmail + Calendar + Drive) ──────────────
# The standard install uses Claude Desktop → Settings → Connectors.
# No Google Cloud project, downloaded OAuth file or key is required.
# Legacy scripts remain in scripts/ only for a future custom integration.


# ─── YOUR INTEGRATIONS ────────────────────────────────────────
# Keys for your own business tools land here as /new-capability
# builds each integration (CRM, payments, booking, email platform...).
